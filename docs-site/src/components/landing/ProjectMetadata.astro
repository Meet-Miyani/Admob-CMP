---
/**
 * The hero spec strip: the four facts a developer checks before reading any
 * further — what to depend on, under what licence, on which platforms, against
 * which Kotlin. Rendered by Hero.astro, above the headline.
 *
 * This used to be a five-row definition list sitting in the page body, which
 * repeated the Kotlin version and Maven coordinate that CompatibilityList
 * already prints further down. The release row is gone as well: the version is
 * the last segment of the coordinate, so printing it separately said nothing
 * new.
 *
 * All values come from `landingMeta`; this component duplicates no literals.
 * The coordinate keeps `tabindex="0"` so it can be reached and copied without a
 * pointer.
 */
import { landingMeta } from '../../data/landing';
import '../../styles/landing.css';

const platforms = `Android ${landingMeta.androidMinSdk}+ / iOS ${landingMeta.iosDeploymentTarget}+`;
---

<dl class="landing-meta">
  <div>
    <dt>Maven</dt>
    <dd>
      <code class="admob-font-mono" tabindex="0">{landingMeta.mavenCoordinate}</code>
    </dd>
  </div>
  <div>
    <dt>Licence</dt>
    <dd>{landingMeta.licenseName}</dd>
  </div>
  <div>
    <dt>Platforms</dt>
    <dd>{platforms}</dd>
  </div>
  <div>
    <dt>Kotlin</dt>
    <dd>{landingMeta.kotlinVersion}</dd>
  </div>
</dl>
